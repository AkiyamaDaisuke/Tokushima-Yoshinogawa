<Window x:Class="Tokushima_Yoshinogawa_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tokushima_Yoshinogawa_WPF"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        
        Title="MainWindow" Height="1080" Width="1920">
    
    <Grid Background="#f5f5f7">
        <!-- Utilizando esta cor pois branco "White" costuma ofuscar/incomodar usuários-->
        <TextBlock Text="Tokushima &amp; Yoshinogawa" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0, 20,0,0" FontSize="100"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Jogar" FontSize="45" Click="Jogar_Click" Height="95" Width="900" Margin="0,0,0,15"/>
            <Button Content="Sobre" FontSize="45" Click="Sobre_Click" Height="95" Width="900" Margin="0,15"/>
            <Button Content="Sair" FontSize="45" Click="Close_Click" Height="95" Width="900" Margin="0,15,0,0"/>
        </StackPanel>

    </Grid>
</Window>
