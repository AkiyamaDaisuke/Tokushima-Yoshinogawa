<Window x:Class="Tokushima_Yoshinogawa_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tokushima_Yoshinogawa_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing">
    
    <Grid Background="#f5f5f7">
        <!-- Utilizando esta cor pois branco "White" costuma ofuscar/incomodar usuários-->
        <TextBlock Text="Tokushima &amp; Yoshinogawa" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0, 20,0,0" FontSize="50"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Jogar" Click="Jogar_Click" Height="45" Width="150" Margin="0,0,0,5"/>
            <Button Content="Sobre" Click="Sobre_Click" Height="45" Width="150" Margin="0,5"/>
            <Button Content="Sair" Click="Close_Click" Height="45" Width="150" Margin="0,5,0,0"/>
        </StackPanel>

    </Grid>
</Window>
