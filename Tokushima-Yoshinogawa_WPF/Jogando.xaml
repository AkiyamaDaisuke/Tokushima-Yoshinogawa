<Window x:Class="Tokushima_Yoshinogawa_WPF.Jogando"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova partida" Height="650" Width="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#f5f5f7">
    <Grid Margin="36">
        <StackPanel x:Name="Configuracao" Width="520" VerticalAlignment="Center">
            <TextBlock Text="Nova partida" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <TextBlock Text="Nome do jogador" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoJogador" Height="42" FontSize="18" Padding="8" Margin="0,0,0,18"/>
            <TextBlock Text="Nome da cidade" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoCidade" Text="Tokushima"  Height="42" FontSize="18" Padding="8" Margin="0,0,0,18"/>
            <TextBlock Text="Dificuldade" FontSize="18" Margin="0,0,0,6"/>
            <ComboBox x:Name="SelecaoDificuldade" Height="42" FontSize="18" SelectedIndex="1" Margin="0,0,0,8">
                <ComboBoxItem Content="Fácil"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="Difícil"/>
            </ComboBox>
            <TextBlock Text="A dificuldade define a satisfação inicial da cidade." FontSize="14" Foreground="#555" Margin="0,0,0,20"/>
            <Button Content="Começar partida" Height="50" FontSize="20" Click="Comecar_Click"/>
            <Button Content="Voltar ao menu" Height="42" FontSize="16" Margin="0,10,0,0" Click="Voltar_Click"/>
        </StackPanel>

        <StackPanel x:Name="ResumoPartida" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Partida iniciada" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <TextBlock x:Name="ResumoJogador" FontSize="24" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="NomeCidade" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="ResumoDificuldade" FontSize="20" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="ResumoSatisfacao" FontSize="26" FontWeight="Bold" TextAlignment="Center" Foreground="#245c3a"/>
            <TextBlock Text="Este é o valor inicial; as decisões da partida podem alterá-lo." FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Width="480" Margin="0,16,0,24"/>
            <Button Content="Voltar ao menu" Width="240" Height="46" FontSize="18" Click="Voltar_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
