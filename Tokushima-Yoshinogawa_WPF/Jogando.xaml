<Window x:Class="Tokushima_Yoshinogawa_WPF.Jogando"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova partida" Height="650" Width="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#f5f5f7">
    <Grid Margin="36">
        <StackPanel x:Name="Configuracao" Width="520" VerticalAlignment="Center">
            <TextBlock Text="Nova partida" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <TextBlock Text="Nome do jogador" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoJogador" Height="42" FontSize="18" Padding="8" Margin="0,0,0,18"/>
            <TextBlock Text="Nome da cidade" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoCidade" Text="Tokushima"  Height="42" FontSize="18" Padding="8" Margin="0,0,0,18"/>
            <TextBlock Text="Nome do segundo jogador" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoJogador2" Text="Jogador 2" Height="42" FontSize="18" Padding="8" Margin="0,0,0,12"/>
            <TextBlock Text="Nome da segunda cidade" FontSize="18" Margin="0,0,0,6"/>
            <TextBox x:Name="CampoCidade2" Text="Yoshinogawa" Height="42" FontSize="18" Padding="8" Margin="0,0,0,12"/>
            <TextBlock Text="Dificuldade" FontSize="18" Margin="0,0,0,6"/>
            <ComboBox x:Name="SelecaoDificuldade" Height="42" FontSize="18" SelectedIndex="1" Margin="0,0,0,8">
                <ComboBoxItem Content="Fácil"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="Difícil"/>
            </ComboBox>
            <TextBlock Text="Quantidade de rodadas" FontSize="18" Margin="0,0,0,6"/>
            <ComboBox x:Name="SelecaoRodadas" Height="42" FontSize="18" SelectedIndex="2" Margin="0,0,0,8">
                <ComboBoxItem Content="5 rodadas" Tag="5"/>
                <ComboBoxItem Content="7 rodadas" Tag="7"/>
                <ComboBoxItem Content="10 rodadas" Tag="10"/>
            </ComboBox>
            <TextBlock Text="A dificuldade define a satisfação inicial da cidade." FontSize="14" Foreground="#555" Margin="0,0,0,20"/>
            <Button Content="Começar partida" Height="50" FontSize="20" Click="Comecar_Click"/>
            <Button Content="Voltar ao menu" Height="42" FontSize="16" Margin="0,10,0,0" Click="Voltar_Click"/>
        </StackPanel>

        <ScrollViewer x:Name="ResumoPartida" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="Partida iniciada" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <TextBlock x:Name="ResumoJogador" FontSize="22" TextAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="NomeCidade" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="ResumoDificuldade" FontSize="18" TextAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TurnoTexto" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="#263c5a" Margin="0,0,0,8"/>
                <TextBlock x:Name="ResumoSatisfacao" FontSize="22" FontWeight="Bold" TextAlignment="Center" Foreground="#245c3a" Margin="0,0,0,20"/>
                <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#ddd" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Mercado da cidade" FontSize="30" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SaldoTexto" FontSize="24" FontWeight="SemiBold" Foreground="#245c3a" Margin="0,0,0,16"/>
                        <TextBlock x:Name="EstoqueTexto" FontSize="18" Margin="0,0,0,16"/>
                        <TextBlock Text="Preços: grãos — compra 10 Yenes / venda 7 Yenes; terras — compra 100 Yenes / venda 70 Yenes." TextWrapping="Wrap" FontSize="15" Foreground="#555" Margin="0,0,0,16"/>
                        <DockPanel LastChildFill="False" Margin="0,4">
                            <TextBlock Text="Grãos" FontSize="18" Width="100" VerticalAlignment="Center"/>
                            <TextBox x:Name="QuantidadeGraos" Text="1" Width="90" Height="38" FontSize="18" Padding="6" Margin="8,0"/>
                            <Button Content="Comprar" Tag="graos-comprar" Width="120" Height="38" Margin="4,0" Click="Mercado_Click"/>
                            <Button Content="Vender" Tag="graos-vender" Width="120" Height="38" Margin="4,0" Click="Mercado_Click"/>
                        </DockPanel>
                        <DockPanel LastChildFill="False" Margin="0,4">
                            <TextBlock Text="Terras" FontSize="18" Width="100" VerticalAlignment="Center"/>
                            <TextBox x:Name="QuantidadeTerras" Text="1" Width="90" Height="38" FontSize="18" Padding="6" Margin="8,0"/>
                            <Button Content="Comprar" Tag="terras-comprar" Width="120" Height="38" Margin="4,0" Click="Mercado_Click"/>
                            <Button Content="Vender" Tag="terras-vender" Width="120" Height="38" Margin="4,0" Click="Mercado_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="MensagemMercado" FontSize="16" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#ddd" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Construções e soldados" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="DefesaTexto" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Construir fazenda (250 Yenes)" Height="42" Padding="12,4" Margin="0,0,10,8" Click="ConstruirFazenda_Click"/>
                            <Button Content="Construir quartel (400 Yenes)" Height="42" Padding="12,4" Margin="0,0,10,8" Click="ConstruirQuartel_Click"/>
                            <TextBox x:Name="QuantidadeSoldados" Text="1" Width="70" Height="38" FontSize="18" Padding="6" Margin="0,0,8,8"/>
                            <Button Content="Recrutar (60 Yenes cada)" Height="42" Padding="12,4" Margin="0,0,10,8" Click="Recrutar_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Fazendas aumentam a colheita. O quartel libera o recrutamento; soldados custam 2 Yenes por rodada." FontSize="14" Foreground="#555" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MensagemDefesa" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#ddd" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Agricultura e população" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="AgriculturaTexto" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel LastChildFill="False" Margin="0,4">
                            <TextBlock Text="Terras para plantar" FontSize="17" VerticalAlignment="Center"/>
                            <TextBox x:Name="QuantidadePlantio" Text="1" Width="90" Height="38" FontSize="18" Padding="6" Margin="12,0"/>
                            <Button Content="Plantar" Width="130" Height="38" Click="Plantar_Click"/>
                        </DockPanel>
                        <TextBlock Text="Cada terra plantada consome 1 grão e rende 3 grãos na próxima rodada." FontSize="14" Foreground="#555" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#ddd" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Governo e impostos" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="GovernoTexto" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel LastChildFill="False" Margin="0,4">
                            <TextBlock Text="Alíquota de imposto" FontSize="17" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AliquotaImposto" Width="140" Height="38" FontSize="17" SelectedIndex="1" Margin="12,0" SelectionChanged="AliquotaImposto_SelectionChanged">
                                <ComboBoxItem Content="5%" Tag="5"/>
                                <ComboBoxItem Content="10%" Tag="10"/>
                                <ComboBoxItem Content="20%" Tag="20"/>
                            </ComboBox>
                        </DockPanel>
                        <Button x:Name="BotaoFecharRodada" Content="Fechar rodada" Width="190" Height="44" FontSize="17" Click="FecharRodada_Click" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="MensagemRodada" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="Voltar ao menu" Width="240" Height="46" FontSize="18" Click="Voltar_Click" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="TelaVitoria" Visibility="Collapsed" Background="#f5f5f7" Panel.ZIndex="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
                <TextBlock Text="Fim da partida" FontSize="42" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock x:Name="ResultadoTexto" FontSize="26" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>
                <Button Content="Voltar ao menu" Width="240" Height="48" FontSize="18" Click="Voltar_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
